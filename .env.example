# Copy to .env. Replace the secret before sharing or deploying this service.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DATABASE_NAME=yphish
DATABASE_USER=yphish
DATABASE_PASSWORD=replace-with-a-database-password
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Optional host port for pgAdmin when using Compose; the web container still uses db:5432.
POSTGRES_HOST_PORT=5433
PRIVATE_ARTIFACT_ROOT=private_artifacts
