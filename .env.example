# Copy to .env. Replace the secret before sharing or deploying this service.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DATABASE_NAME=yphish
DATABASE_USER=yphish
DATABASE_PASSWORD=replace-with-a-database-password
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Optional host port for pgAdmin when using Compose; the web container still uses db:5432.
POSTGRES_HOST_PORT=5433
PRIVATE_ARTIFACT_ROOT=private_artifacts
RABBITMQ_PASSWORD=replace-with-a-distinct-rabbitmq-password
GMAIL_POLL_INTERVAL_SECONDS=60
GMAIL_ANALYSIS_SWEEP_INTERVAL_SECONDS=30
GMAIL_ANALYSIS_DISPATCH_BATCH_SIZE=100
GMAIL_ANALYSIS_REDISPATCH_SECONDS=120
GMAIL_ANALYSIS_LEASE_SECONDS=300
GMAIL_RETRY_BASE_SECONDS=5
GMAIL_RETRY_MAX_SECONDS=3600
DETECTION_INDICATOR_MODE=operational
DETECTION_AUTH_RESULTS_MODE=untrusted_context
# No mailbox content is selected for training by default. See docs/module7-classifier.md.
CLASSIFIER_MODEL_ROOT=model_artifacts
CLASSIFIER_ACTIVE_VERSION=
CLASSIFIER_DATASET_SELECTION_FILE=
CLASSIFIER_SIGNING_KEY=
CLASSIFIER_APPROVAL_KEY=
CLASSIFIER_ALLOW_SYNTHETIC=0
INVESTIGATION_ENABLED=1
INVESTIGATION_DNS_ENABLED=0
INVESTIGATION_MAX_ROUNDS=4
INVESTIGATION_MAX_CALLS=4
INVESTIGATION_TIMEOUT_SECONDS=20
INVESTIGATION_TOOL_TIMEOUT_SECONDS=3
INVESTIGATION_THREAD_MAX_MESSAGES=5
INVESTIGATION_THREAD_MAX_BYTES=262144
INVESTIGATION_THREAD_MAX_AGE_DAYS=30
INVESTIGATION_SENDER_MAX_CASES=100
INVESTIGATION_SWEEP_INTERVAL_SECONDS=30
GMAIL_RESPONSE_ENABLED=1
GMAIL_RESPONSE_SWEEP_INTERVAL_SECONDS=30
GMAIL_RESPONSE_ORG_HOURLY_LIMIT=100
GMAIL_RESPONSE_MAILBOX_HOURLY_LIMIT=20
GMAIL_RESPONSE_FAILURE_THRESHOLD=5
GMAIL_RESPONSE_CIRCUIT_SECONDS=1800
GMAIL_RESPONSE_LEASE_SECONDS=180
GMAIL_RESPONSE_MAX_CASE_AGE_HOURS=24
# Host Python execution only. Compose mounts ./secrets at /run/secrets.
# GOOGLE_INGESTION_SERVICE_ACCOUNT_FILE=D:/absolute/path/to/ingestion-service-account.json
# Separate response identity for Module 9; Compose supplies the worker-only path.
# GOOGLE_RESPONSE_SERVICE_ACCOUNT_FILE=D:/absolute/path/to/separate-response-service-account.json
