# Copy to .env for the dedicated trial host. Never commit .env or service-account keys.
TRIAL_DOMAIN=yphish.example.org
DJANGO_SECRET_KEY=replace-with-unique-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=yphish.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://yphish.example.org
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_TRUST_PROXY_HEADERS=1
DJANGO_HSTS_SECONDS=3600
DATABASE_NAME=yphish
DATABASE_USER=yphish
DATABASE_PASSWORD=replace-with-unique-database-password
DATABASE_PORT=5432
RABBITMQ_PASSWORD=replace-with-distinct-rabbitmq-password
GMAIL_POLL_INTERVAL_SECONDS=60
GMAIL_ANALYSIS_SWEEP_INTERVAL_SECONDS=30
GMAIL_RESPONSE_ENABLED=0
GMAIL_RESPONSE_ORG_HOURLY_LIMIT=10
GMAIL_RESPONSE_MAILBOX_HOURLY_LIMIT=2
GMAIL_RESPONSE_FAILURE_THRESHOLD=3
GMAIL_RESPONSE_CIRCUIT_SECONDS=3600
GMAIL_RESPONSE_MAX_CASE_AGE_HOURS=24
ARTIFACT_RETENTION_ENABLED=1
ARTIFACT_RETENTION_BATCH_SIZE=100
DETECTION_INDICATOR_MODE=operational
DETECTION_AUTH_RESULTS_MODE=untrusted_context
CLASSIFIER_ACTIVE_VERSION=
CLASSIFIER_SIGNING_KEY=
CLASSIFIER_APPROVAL_KEY=
CLASSIFIER_ALLOW_SYNTHETIC=0
INVESTIGATION_ENABLED=1
INVESTIGATION_DNS_ENABLED=0
